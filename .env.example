# ==============================================================================
# Wedding Uploader Configuration
# ==============================================================================

# --- Event & Couple Branding ---
# The names of the couple (e.g., "Sarah & Alex", "Emma & Liam")
COUPLE_NAME=Sarah & Alex

# The main title displayed in the browser tab and social previews
EVENT_TITLE=Sarah & Alex's Wedding

# Subtitle shown beneath the couple's names on the upload page
EVENT_SUBTITLE=Share your moments from our special day

# Public URL of the app (used for Open Graph previews when sharing links via SMS/WhatsApp)
# e.g., https://photos.ourwedding.com or https://ourwedding.duckdns.org
APP_URL=http://localhost:3000

# Server timezone for message and upload timestamps (e.g., America/New_York, Europe/London, UTC)
TZ=UTC

# Port for the web application
PORT=3000

# Host path where uploaded photos, videos, messages, and logs will be stored
# Can be a relative path (e.g. ./media) or absolute path (e.g. /mnt/storage/wedding or /opt/wedding/media)
MEDIA_UPLOAD_PATH=./media

# Container name
CONTAINER_NAME=wedding-uploader

# ==============================================================================
# Optional Companion Services (Only if using Nginx Proxy Manager & DuckDNS)
# ==============================================================================

# Host paths for Nginx Proxy Manager data and Let's Encrypt certificates
NPM_DATA_PATH=./NPM/data
NPM_LETSENCRYPT_PATH=./NPM/letsencrypt

# DuckDNS Dynamic DNS configuration (optional)
# Free account from https://www.duckdns.org
DUCKDNS_SUBDOMAINS=yoursubdomain
DUCKDNS_TOKEN=your-duckdns-token-here
